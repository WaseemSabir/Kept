---
// Keys and what they do, as a two-column table. The keys sit in the same
// 144 px column as fact labels, so the page keeps one left edge and one
// second edge. A key list breaks only at its plain spaces (before "or" and
// "then", per src/data/shortcuts.ts): each run between them is one
// unbreakable group, since browsers may otherwise break beside a key cap.
import type { Shortcut } from '../data/shortcuts';
import Inline from './Inline.astro';

interface Props {
  items: Shortcut[];
  /** Read to assistive technology; shown only when `showCaption` is set. */
  caption: string;
  showCaption?: boolean;
}

const { items, caption, showCaption = false } = Astro.props;
---

<table class="shortcuts">
  <caption class={showCaption ? 'caption' : 'visually-hidden'}>{caption}</caption>
  <thead>
    <tr>
      <th scope="col"><span class="visually-hidden">Keys</span></th>
      <th scope="col"><span class="visually-hidden">Action</span></th>
    </tr>
  </thead>
  <tbody>
    {
      items.map((shortcut) => (
        <tr>
          <th scope="row" class="keys">
            {shortcut.keys.split(' ').map((group, index) => (
              <>
                {index > 0 && ' '}
                <span class="group">
                  <Inline text={group} />
                </span>
              </>
            ))}
          </th>
          <td>
            <Inline text={shortcut.action} />
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  /* Fixed layout: the keys column is exactly the label column, whatever it holds. */
  .shortcuts {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    text-align: start;
  }

  thead th:first-child {
    width: var(--label-column);
  }

  .caption {
    text-align: start;
    font-size: var(--label-size);
    color: var(--ink-muted);
    padding-block-end: var(--space-3);
  }

  th,
  td {
    padding: 0;
    padding-block: 6px;
    text-align: start;
    vertical-align: baseline;
    font-weight: 400;
  }

  /* The column headers are for assistive technology only. */
  thead th {
    padding: 0;
  }

  .keys {
    padding-inline-end: var(--space-3);
    font-size: var(--label-size);
    color: var(--ink-muted);
  }

  .group {
    white-space: nowrap;
  }

  /*
    A phone: a narrower keys column, just wide enough for "None by default"
    and the longest group, and a tighter gap; "↑ ↓ or ⌃P ⌃N" goes on two
    lines, breaking before "or".
  */
  @media (max-width: 559px) {
    thead th:first-child {
      width: 120px;
    }

    .keys {
      padding-inline-end: var(--space-2);
    }
  }
</style>
