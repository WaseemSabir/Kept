---
// A key cap and what it does, "⌘P Pin", at the app's footer sizes: 10 pt
// medium in the cap, 11 pt medium beside it.
interface Props {
  keys: string;
  label: string;
  /** Names the hint for scripts (data-hint), e.g. "pin" to say "Unpin". */
  name: string;
  /** Left out when the panel is narrow (a phone). */
  optional?: boolean;
}

const { keys, label, name, optional = false } = Astro.props;
---

<span class:list={['hint', { optional }]} data-hint={name}>
  <kbd class="cap">{keys}</kbd>
  <span class="label" data-hint-label>{label}</span>
</span>

<style>
  .hint {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    white-space: nowrap;
  }

  .cap {
    display: inline-block;
    min-width: 18px;
    height: 16px;
    padding: 0 4px;
    font-family: var(--font);
    font-size: 10px;
    font-weight: 500;
    line-height: 16px;
    text-align: center;
    color: var(--ink-muted);
    background: var(--wash);
    border-radius: 4px;
    box-shadow: inset 0 0 0 0.5px var(--hairline);
  }

  .label {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  @media (max-width: 759px) {
    .optional {
      display: none;
    }
  }
</style>
