---
// A key cap and what it does, "⌘P Pin", at the app's footer sizes: 10 pt
// medium in the cap, 11 pt medium beside it. Clicking it does what the key
// does. It stays out of the Tab order: with the keyboard in the panel the
// key itself is quicker, and Tab goes on through the page.
interface Props {
  keys: string;
  label: string;
  /** Names the hint for scripts (data-hint), e.g. "pin" to say "Unpin". */
  name: string;
  /** The key for assistive technology (aria-keyshortcuts), e.g. "Meta+P". */
  shortcut: string;
  /** Left out when the panel is narrow (a phone). */
  optional?: boolean;
  hidden?: boolean;
}

const { keys, label, name, shortcut, optional = false, hidden = false } = Astro.props;
---

<button
  type="button"
  class:list={['hint', { optional }]}
  tabindex="-1"
  aria-keyshortcuts={shortcut}
  data-hint={name}
  hidden={hidden}
>
  <kbd class="cap" aria-hidden="true">{keys}</kbd>
  <span class="label" data-hint-label>{label}</span>
</button>

<style>
  .hint {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  .hint[hidden] {
    display: none;
  }

  .cap {
    display: inline-block;
    min-width: 18px;
    height: 16px;
    padding: 0 4px;
    font-family: var(--font);
    font-size: 10px;
    font-weight: 500;
    line-height: 16px;
    text-align: center;
    color: var(--ink-muted);
    background: var(--wash);
    border-radius: 4px;
    box-shadow: inset 0 0 0 0.5px var(--hairline);
  }

  .label {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .hint:hover .label {
    color: var(--ink);
  }

  @media (max-width: 759px) {
    .optional {
      display: none;
    }
  }
</style>
