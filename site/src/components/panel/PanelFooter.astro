---
// Hints for what the keys do now, with a clip selected and the search
// empty. The script changes them as the app does: "Unpin" on a pinned clip,
// no "Delete" while searching, and with nothing selected only "esc Clear
// search" or "esc Close".
import KeyHint from './KeyHint.astro';
---

<div class="footer" data-panel-footer>
  <KeyHint keys="⏎" label="Paste" name="paste" shortcut="Enter" />
  <KeyHint keys="⌥⏎" label="Paste as plain text" name="paste-plain" shortcut="Alt+Enter" />
  <KeyHint keys="⌘⏎" label="Copy" name="copy" shortcut="Meta+Enter" optional />
  <KeyHint keys="⌘P" label="Pin" name="pin" shortcut="Meta+P" optional />
  <KeyHint keys="⌘⌫" label="Delete" name="delete" shortcut="Meta+Backspace" optional />
  <KeyHint keys="esc" label="Close" name="esc" shortcut="Escape" hidden />
</div>

<style>
  .footer {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 30px;
    padding: 0 12px;
    overflow: hidden;
  }
</style>
