---
// A screenshot from docs/images with its caption. The PNGs are 2x and carry
// their own window shadow in a transparent margin; the image bleeds by that
// margin so the window's edge sits on the column's left edge. The page adds
// no shadow of its own.
//
// The site's Content-Security-Policy allows no `style` attributes, so the
// geometry can't be written per image. The image says which window it shows
// (data-window, data-inset) and the stylesheet below turns that into custom
// properties; everything else is worked out in CSS from the column's width.
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** The window's width in CSS px (the PNG is 2x). */
  windowWidth: number;
  /** The transparent margin around the window, in CSS px. */
  inset: number;
}

const { src, alt, caption, windowWidth, inset } = Astro.props;

/** Window widths and insets with a rule in the stylesheet below. Add a rule there to add one here. */
const styledWindows = [720, 560];
const styledInsets = [20];
if (!styledWindows.includes(windowWidth) || !styledInsets.includes(inset)) {
  throw new Error(
    `Screenshot: no rule for a ${windowWidth} px window with a ${inset} px margin; add one to Screenshot.astro's stylesheet.`,
  );
}

/** The whole image at 1x, shadow margin included. */
const shownWidth = src.width / 2;
const shownHeight = src.height / 2;
if (shownWidth !== windowWidth + 2 * inset) {
  throw new Error(
    `Screenshot: ${src.src} is ${shownWidth} px wide at 1x; a ${windowWidth} px window with a ${inset} px margin is ${windowWidth + 2 * inset}.`,
  );
}
const scale = shownWidth / windowWidth;
// Below this viewport the column is narrower than the window and the image scales with it.
const fitsFrom = windowWidth + 48;
const sizes = `(min-width: ${fitsFrom}px) ${shownWidth}px, calc((100vw - 48px) * ${scale.toFixed(4)})`;
const widths = [shownWidth, Math.round(shownWidth * 1.5), src.width];
---

<figure class="screenshot" data-window={windowWidth} data-inset={inset}>
  <Picture
    src={src}
    alt={alt}
    width={shownWidth}
    height={Math.round(shownHeight)}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading="lazy"
    decoding="async"
    pictureAttributes={{ class: 'picture' }}
  />
  <figcaption class="small">{caption}</figcaption>
</figure>

<style>
  /* The window's width and the margin around it, as plain numbers (CSS px) for calc(). */
  .screenshot[data-window='720'] {
    --window: 720;
  }

  .screenshot[data-window='560'] {
    --window: 560;
  }

  .screenshot[data-inset='20'] {
    --inset: 20;
  }

  /* 100cqi below is the column's width. */
  .screenshot {
    container-type: inline-size;
  }

  .screenshot :global(.picture) {
    display: block;
  }

  .screenshot :global(img) {
    /* The margin as shown: all of it while the window fits the column, scaled with the window below that. */
    --bleed: min(var(--inset) * 1px, 100cqi * var(--inset) / var(--window));
    /*
      The PNG's shadow is cut off at the edge of its margin (still ~6% black
      at the bottom), which shows as a faint box on the page's color. Fading
      the outer 70% of the margin hides the cut and leaves the window untouched.
    */
    --fade: calc(var(--bleed) * 0.7);
    max-width: none;
    width: min(
      (var(--window) + 2 * var(--inset)) * 1px,
      100cqi * (var(--window) + 2 * var(--inset)) / var(--window)
    );
    height: auto;
    margin: calc(-1 * var(--bleed));
    margin-inline-end: 0;
    mask-image:
      linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
    mask-composite: intersect;
  }

  figcaption {
    margin-block-start: var(--space-3);
    max-width: var(--measure);
  }
</style>
