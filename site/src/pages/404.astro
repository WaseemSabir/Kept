---
import { pageTitle } from '../config';
import Base from '../layouts/Base.astro';
---

<Base title={pageTitle('Page not found')} description="This page isn’t on Kept’s website." indexable={false}>
  <div class="intro">
    <h1>That page isn’t here.</h1>
    <p>It may have moved, or the address has a typo. Everything about Kept starts on the home page.</p>
    <p><a href="/">Go to the home page</a></p>
  </div>
</Base>

<style>
  .intro {
    padding-block-start: var(--space-8);
  }

  .intro p {
    max-width: var(--measure);
    margin-block-start: var(--space-5);
  }

  .intro p + p {
    margin-block-start: var(--space-4);
  }
</style>
